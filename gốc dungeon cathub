local function UpdateMobESP()
    pcall(function()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local myPos = hrp and hrp.Position or Vector3.zero

        local dungeon = workspace:FindFirstChild("dungeon") or workspace:FindFirstChild("enemies")
        if not dungeon then return end

        for _, m in ipairs(dungeon:GetDescendants()) do
            if m:IsA("Model") and m ~= char then
                local eHum = m:FindFirstChildOfClass("Humanoid")
                local ePart = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Head") or m:FindFirstChildOfClass("BasePart")

                if eHum and eHum.Health > 0 and ePart then
                    if Config.MobESP then
                        local isInActiveRoom = m:IsDescendantOf(workspace) and (m.Parent and m.Parent.Parent and m.Parent.Parent.Name == currentActiveRoomName or m.Parent and m.Parent.Name == currentActiveRoomName)

                        local hl = m:FindFirstChild("CatMobHighlight")
                        if not hl then
                            hl = Instance.new("Highlight")
                            hl.Name = "CatMobHighlight"
                            hl.FillTransparency = 0.55
                            hl.OutlineTransparency = 0
                            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            hl.Adornee = m
                            hl.Parent = m
                        end

                        if isInActiveRoom then
                            hl.FillColor = Color3.fromRGB(255, 50, 50)
                            hl.OutlineColor = Color3.fromRGB(255, 220, 40)
                        else
                            hl.FillColor = Color3.fromRGB(80, 140, 255)
