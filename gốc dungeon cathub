                    hl.Name = "CatMobHighlight"
                    hl.FillTransparency = 0.50
                    hl.OutlineTransparency = 0
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Adornee = m
                    hl.Parent = m
                end

                if isInActiveRoom then
                    hl.FillColor = Color3.fromRGB(255, 50, 50)
                    hl.OutlineColor = Color3.fromRGB(255, 220, 40)
                else
                    hl.FillColor = Color3.fromRGB(70, 150, 255)
                    hl.OutlineColor = Color3.fromRGB(120, 190, 255)
                end

                local bg = ePart:FindFirstChild("CatMobESP")
                if not bg then
                    bg = Instance.new("BillboardGui")
                    bg.Name = "CatMobESP"
                    bg.Adornee = ePart
                    bg.Size = UDim2.new(0, 240, 0, 32)
                    bg.StudsOffset = Vector3.new(0, 10.5, 0) -- High above boss head & horns
                    bg.ExtentsOffsetWorldSpace = Vector3.new(0, 4.0, 0)
                    bg.AlwaysOnTop = true
                    bg.MaxDistance = 30000 -- Visible from any distance across the entire map
                    bg.Parent = ePart

                    local txt = Instance.new("TextLabel")
