local function createToggle(parent, title, desc, defaultState, callback)
    local card = createCard(parent, 68)
    
    local tLabel = Instance.new("TextLabel")
    tLabel.Size = UDim2.new(1, -85, 0, 22)
    tLabel.Position = UDim2.new(0, 12, 0, 10)
    tLabel.BackgroundTransparency = 1
    tLabel.Text = title
    tLabel.TextColor3 = Theme.TextTitle
    tLabel.TextSize = 12
    tLabel.Font = Enum.Font.GothamBold
    tLabel.TextXAlignment = Enum.TextXAlignment.Left
    tLabel.Parent = card
    
    local dLabel = Instance.new("TextLabel")
    dLabel.Size = UDim2.new(1, -85, 0, 24)
    dLabel.Position = UDim2.new(0, 12, 0, 32)
    dLabel.BackgroundTransparency = 1
    dLabel.Text = desc
    dLabel.TextColor3 = Theme.TextMuted
    dLabel.TextSize = 10
    dLabel.Font = Enum.Font.GothamMedium
    dLabel.TextXAlignment = Enum.TextXAlignment.Left
    dLabel.Parent = card
    
    local SwitchBtn = Instance.new("TextButton")
    SwitchBtn.Size = UDim2.new(0, 52, 0, 28)
    SwitchBtn.Position = UDim2.new(1, -66, 0.5, -14)
    SwitchBtn.BackgroundColor3 = defaultState and Theme.AccentGreen or Color3.fromRGB(60, 48, 36)
    SwitchBtn.Text = ""
    SwitchBtn.BorderSizePixel = 0
    SwitchBtn.AutoButtonColor = false
    SwitchBtn.Parent = card

    local TrackCorner = Instance.new("UICorner")
    TrackCorner.CornerRadius = UDim.new(1, 0)
    TrackCorner.Parent = SwitchBtn

    local TrackStroke = Instance.new("UIStroke")
    TrackStroke.Color = defaultState and Color3.fromRGB(120, 230, 150) or Color3.fromRGB(80, 65, 50)
    TrackStroke.Thickness = 1.2
    TrackStroke.Parent = SwitchBtn

    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.new(0, 22, 0, 22)
    Knob.Position = defaultState and UDim2.new(1, -25, 0.5, -11) or UDim2.new(0, 3, 0.5, -11)
    Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Knob.BorderSizePixel = 0
    Knob.Parent = SwitchBtn

    local KnobCorner = Instance.new("UICorner")
    KnobCorner.CornerRadius = UDim.new(1, 0)
    KnobCorner.Parent = Knob

    local state = defaultState
    SwitchBtn.MouseButton1Click:Connect(function()
        state = not state
        local targetPos = state and UDim2.new(1, -25, 0.5, -11) or UDim2.new(0, 3, 0.5, -11)
        local targetColor = state and Theme.AccentGreen or Color3.fromRGB(60, 48, 36)
        local targetStroke = state and Color3.fromRGB(120, 230, 150) or Color3.fromRGB(80, 65, 50)

        TweenService:Create(Knob, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = targetPos
        }):Play()
        TweenService:Create(SwitchBtn, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = targetColor
        }):Play()
        TweenService:Create(TrackStroke, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Color = targetStroke
        }):Play()

        callback(state)
    end)
    return card
end

