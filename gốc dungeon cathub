-- 7. HỆ THỐNG NÉ CHIÊU ĐỎ THÔNG MINH (THEO VIDEO REAPERX HUB)
--    KHI GẶP VÙNG ĐỎ -> TỰ ĐỘNG BƯỚC RA KHỎI PHẠM VI MÀU ĐỎ ĐỨNG VÀO KHE AN TOÀN
-- ======================================================================
local function GetRedTelegraphDodgeVector(playerPos)
    if not Config.AutoDodgeRed then return nil end
    local char = LocalPlayer.Character
    local bestDodgeDir = nil
    local minDistanceToExit = math.huge

    local function inspectPart(obj)
        if not obj:IsA("BasePart") then return end
        if char and obj:IsDescendantOf(char) then return end

        local name = obj.Name:lower()
        local parentName = obj.Parent and obj.Parent.Name:lower() or ""
        local isDanger = false

        -- 1. Nhận diện theo tên telegraph chuẩn của Dungeon Quest
        if name == "precast" or name:find("indicator") or name:find("telegraph") or name:find("danger") then
            isDanger = true
        elseif parentName:find("spikes") or parentName:find("beam") or parentName:find("aoe") or parentName:find("flame") or parentName:find("laser") then
            if name == "hitbox" or name == "part" or name == "precast" then
                isDanger = true
            end
        end

        -- 2. Nhận diện theo màu đỏ cảnh báo trên mặt sàn
        if not isDanger and obj.Transparency < 0.95 and not obj.CanCollide then
            local c = obj.Color
            local isRed = (c.R > 0.70 and c.G < 0.38 and c.B < 0.38)
            local isCrimson = (c.R > 0.80 and c.G < 0.50 and c.B < 0.50)
            local isPurple = (c.R > 0.50 and c.G < 0.20 and c.B > 0.50)
            if isRed or isCrimson or isPurple then
                isDanger = true
            end
        end

        if isDanger then
            -- Chuyển tọa độ người chơi vào Object Space của part đỏ để tính toán chính xác
            local localPos = obj.CFrame:PointToObjectSpace(playerPos)
            local halfSize = obj.Size / 2
            local margin = 3.5 -- Vùng đệm an toàn để bước hẳn ra khỏi mép màu đỏ

            local isCylinder = (obj:IsA("Part") and obj.Shape == Enum.PartType.Cylinder) or name:find("circle") or (math.abs(halfSize.X - halfSize.Z) < 1.0 and halfSize.X > 5)

            if isCylinder then
                -- Vùng đỏ hình tròn / hình trụ
                local radius = math.max(halfSize.X, halfSize.Z) + margin
                local distFromCenter = Vector2.new(localPos.X, localPos.Z).Magnitude
                if distFromCenter <= radius and math.abs(localPos.Y) <= (halfSize.Y + 8.0) then
                    local distToExit = radius - distFromCenter
                    local exitObj = (distFromCenter > 0.1) and Vector3.new(localPos.X, 0, localPos.Z).Unit or Vector3.new(1, 0, 0)
                    local exitWorld = obj.CFrame:VectorToWorldSpace(exitObj)
                    local exitDir = Vector3.new(exitWorld.X, 0, exitWorld.Z).Unit

                    if distToExit < minDistanceToExit then
                        minDistanceToExit = distToExit
                        bestDodgeDir = exitDir
                    end
                end
            else
                -- Vùng đỏ hình chữ nhật / dải tia / rẻ quạt (như trong ảnh ReaperX Hub)
                local inX = math.abs(localPos.X) <= (halfSize.X + margin)
                local inZ = math.abs(localPos.Z) <= (halfSize.Z + margin)
                local inY = math.abs(localPos.Y) <= (halfSize.Y + 8.0)

                if inX and inZ and inY then
                    -- Người chơi đang đứng trong vùng đỏ!
                    local distToExitX = (halfSize.X + margin) - math.abs(localPos.X)
                    local distToExitZ = (halfSize.Z + margin) - math.abs(localPos.Z)

                    local exitVectorObject = Vector3.zero
                    local exitDist = 0

                    if distToExitX <= distToExitZ then
                        -- Lối thoát ngắn nhất: Bước dạt ngang qua 2 bên mép (Perpendicular Strafe vào khe an toàn)
                        local signX = (localPos.X >= 0) and 1 or -1
                        exitVectorObject = Vector3.new(signX, 0, 0)
                        exitDist = distToExitX
                    else
                        -- Lối thoát ngắn nhất: Bước theo chiều dọc
                        local signZ = (localPos.Z >= 0) and 1 or -1
                        exitVectorObject = Vector3.new(0, 0, signZ)
                        exitDist = distToExitZ
                    end

                    local exitVectorWorld = obj.CFrame:VectorToWorldSpace(exitVectorObject)
                    local exitDirHorizontal = Vector3.new(exitVectorWorld.X, 0, exitVectorWorld.Z).Unit

                    if exitDist < minDistanceToExit then
                        minDistanceToExit = exitDist
                        bestDodgeDir = exitDirHorizontal
                    end
                end
            end
        end
    end

    for _, fName in ipairs({"flameParts", "vfxPool", "abilities", "mageBossLaserSpawns"}) do
        local f = workspace:FindFirstChild(fName)
        if f then
            for _, o in ipairs(f:GetDescendants()) do inspectPart(o) end
        end
    end

    for _, o in ipairs(workspace:GetChildren()) do
        if o:IsA("BasePart") or o:IsA("Model") then
            if o:IsA("BasePart") then
                inspectPart(o)
            else
                for _, sub in ipairs(o:GetChildren()) do
                    if sub:IsA("BasePart") then inspectPart(sub) end
                end
            end
        end
    end

    return bestDodgeDir
end

