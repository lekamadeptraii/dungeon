local HttpRequest = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
local lastRewardWebhookTick = 0

local function SendRewardEmbedWebhook(rewardData)
    local now = tick()
    if now - lastRewardWebhookTick < 4 then return end
    lastRewardWebhookTick = now

    if not HttpRequest or Config.WebhookUrl == "" or not Config.WebhookUrl:find("http") then return end

    local activeMap, activeDiff, isHardcore = GetActiveMatchDetails()
    local modeText = isHardcore and "Hardcore (1 Life)" or "Normal"

    local itemsList = {}
    local hasLegendary = false

    if type(rewardData) == "table" and rewardData.items then
        for _, itm in ipairs(rewardData.items) do
            local itmName = itm.name or (itm.template and itm.template.Name)
            local itmRarity = tostring(itm.rarity or "Common"):upper()

            -- Only include actual named equipment, omit generic "Item" placeholders
            if itmName and itmName ~= "" and itmName:lower() ~= "item" then
                local icon = "⚪"
                if itmRarity == "LEGENDARY" then icon = "🟠" hasLegendary = true
                elseif itmRarity == "EPIC" then icon = "🟣"
                elseif itmRarity == "RARE" then icon = "🔵"
                elseif itmRarity == "UNCOMMON" then icon = "🟢" end

                table.insert(itemsList, string.format("%s **[%s]** %s", icon, itmRarity, itmName))
            end
        end
    end

    local itemsStr = (#itemsList > 0) and table.concat(itemsList, "\n") or "• No new equipment dropped"
    local goldEarned = (type(rewardData) == "table" and rewardData.gold) and FormatNumber(rewardData.gold) or "0"
    local gemsEarned = (type(rewardData) == "table" and (rewardData.gems or rewardData.eventCurrency)) and FormatNumber(rewardData.gems or rewardData.eventCurrency) or "0"

    local currentGold, currentGems = "0", "0"
    pcall(function()
        local ls = LocalPlayer:FindFirstChild("leaderstats")
        if ls then
            if ls:FindFirstChild("Gold") then currentGold = FormatNumber(ls.Gold.Value) end
            if ls:FindFirstChild("Gems") then currentGems = FormatNumber(ls.Gems.Value) end
        end
    end)

    local desc = string.format(
        "**User :** ||%s||\n" ..
        "**Dungeon:** %s • **%s** (%s)\n\n" ..
        "📦 **Dropped Items:**\n%s\n\n" ..
        "-------------------------\n" ..
        "💰 **Gold Earned:** `+%s Gold`\n" ..
        "💎 **Gems Earned:** `+%s Gems`\n" ..
        "-------------------------\n\n" ..
        "📊 **Current Stats:**\n" ..
        "💰 **Gold:** `%s Gold`\n" ..
        "💎 **Gems:** `%s Gems`",
        LocalPlayer.Name, activeMap, activeDiff, modeText,
        itemsStr, goldEarned, gemsEarned, currentGold, currentGems
    )

    local contentMsg = nil
    if hasLegendary then
        local userId = Config.DiscordUserId ~= "" and Config.DiscordUserId or "everyone"
        contentMsg = string.format("<@%s> 🔥 **CONGRATULATIONS! YOU GOT A LEGENDARY ITEM!** 🔥", userId)
    end

    local payload = {
        username = "🐱 Cat Hub",
        avatar_url = Config.WebhookAvatar,
        content = contentMsg,
        embeds = {
            {
                title = hasLegendary and "🌟 VICTORY & LEGENDARY DROP!" or "🏆 DUNGEON VICTORY & REWARDS",
                description = desc,
                color = hasLegendary and 16753920 or 5814783,
                footer = {text = "Cat Hub • Fast & Auto", icon_url = Config.WebhookAvatar},
                timestamp = DateTime.now():ToIsoDate()
            }
        }
    }

    task.spawn(function()
        pcall(function()
            HttpRequest({
                Url = Config.WebhookUrl,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(payload)
            })
        end)
    end)
end

