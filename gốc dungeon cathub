local function FormatNumber(n)
    n = tonumber(n) or 0
    if n >= 1e9 then
        return string.format("%.2fB", n / 1e9):gsub("%.00", "")
    elseif n >= 1e6 then
        return string.format("%.2fM", n / 1e6):gsub("%.00", "")
    elseif n >= 1e3 then
        return string.format("%.1fK", n / 1e3):gsub("%.0", "")
    else
        return tostring(math.floor(n))
    end
end

