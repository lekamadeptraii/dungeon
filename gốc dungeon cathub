local function RenderDifficultyButtons(mapName)
    for _, child in ipairs(DiffContainer:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local diffList = MapDifficultyDatabase[mapName] or {
        {name = "Easy", lvl = 1}, {name = "Medium", lvl = 6}, {name = "Hard", lvl = 12}, {name = "Insane", lvl = 20}, {name = "Nightmare", lvl = 27}
    }

    local foundSelected = false
    for _, dInfo in ipairs(diffList) do
        if dInfo.name == Config.SelectedDifficulty then
            Config.SelectedLevelReq = dInfo.lvl
            foundSelected = true
            break
        end
    end
    if not foundSelected then
        Config.SelectedDifficulty = diffList[1].name
        Config.SelectedLevelReq = diffList[1].lvl
    end
    UpdateDisplayHeader()

    local btnWidth = math.floor((440 - 24 - (#diffList - 1) * 4) / #diffList)
    for _, dInfo in ipairs(diffList) do
        local dBtn = Instance.new("TextButton")
        dBtn.Size = UDim2.new(0, btnWidth, 1, 0)
        dBtn.BackgroundColor3 = (Config.SelectedDifficulty == dInfo.name) and Theme.Primary or Theme.CardInner
        dBtn.Text = string.format("%s\n(Lv %d)", dInfo.name, dInfo.lvl)
        dBtn.TextColor3 = (Config.SelectedDifficulty == dInfo.name) and Color3.fromRGB(35, 25, 15) or Theme.TextDesc
        dBtn.TextSize = 9
        dBtn.Font = Enum.Font.GothamBold
        dBtn.BorderSizePixel = 0
        dBtn.Parent = DiffContainer

        local dc = Instance.new("UICorner")
        dc.CornerRadius = UDim.new(0, 6)
        dc.Parent = dBtn

        dBtn.MouseButton1Click:Connect(function()
            Config.SelectedDifficulty = dInfo.name
            Config.SelectedLevelReq = dInfo.lvl
            UpdateDisplayHeader()
            for _, b in ipairs(DiffContainer:GetChildren()) do
                if b:IsA("TextButton") then
                    local isThis = b.Text:find(dInfo.name) ~= nil
                    b.BackgroundColor3 = isThis and Theme.Primary or Theme.CardInner
                    b.TextColor3 = isThis and Color3.fromRGB(35, 25, 15) or Theme.TextDesc
                end
            end
        end)
    end
end

